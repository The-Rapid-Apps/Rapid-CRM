# Copy to .env and fill in. rapi-management is a standalone, multi-tenant billing
# platform, so per-app Shopify credentials live in the DB (App table), NOT here.

# --- Database (required) ---
# If your local MySQL uses the caching_sha2_password auth plugin (WAMP's
# default on newer MySQL 8 installs), a non-SSL connection hangs/times out
# without `allowPublicKeyRetrieval=true` — add it if `npm run dev` seems to
# hang on any DB-touching route.
DATABASE_URL="mysql://root@127.0.0.1:3306/rapi_management"

# --- Platform ---
# Public base URL of this platform. Used to build Shopify returnUrl and the
# post-approval charge-return callback.
APP_URL="http://localhost:3000"
# Secret used to sign admin dashboard sessions and merchant billing links.
# Production requires at least 32 characters.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Dedicated, stable key for encrypting Partner API tokens at rest. Production
# requires at least 32 characters. Do not rotate without re-encrypting tokens.
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-separate-32-character-key"
# Dedicated secret sent by the daily scheduler as X-Cron-Secret.
CRON_SECRET="change-me-separately"

# --- Flex billing ---
# Master switch for Partner app credits (downgrade proration and APP_CREDITS
# discounts). Keep false until each App row has Partner credentials populated.
# APP_CREDITS charges fail closed while this is unavailable.
FLEX_PARTNER_CREDITS_ENABLED="false"

# --- Dashboard login ---
# Email + password for now (SSO is a planned later addition). Create the first
# admin user with `npm run db:seed` (reads SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# --- Identify API (POST /v1/identify) ---
# App credentials validated against the X-App-Id / X-App-Api-Key request
# headers. The api key is a secret — never commit real values. Leave the pair
# unset to disable the endpoint (every request is then 401).
IDENTIFY_APP_ID="00000000-0000-0000-0000-000000000000"
IDENTIFY_APP_API_KEY="replace-with-a-long-random-secret"
# Onboard additional apps with numbered pairs (2, 3, ...):
# IDENTIFY_APP_2_ID="11111111-1111-1111-1111-111111111111"
# IDENTIFY_APP_2_API_KEY="another-long-random-secret"
# Per-app fixed-window request cap (requests/minute) for POST /v1/identify.
IDENTIFY_RATE_LIMIT="120"

# --- Postmark (transactional mail: dashboard password reset) ---
# Server API token. Unset = reset links are logged instead of emailed.
POSTMARK_SERVER_TOKEN=""
# Per-environment message stream (Postmark's default is "outbound").
POSTMARK_MESSAGE_STREAM="outbound"
# Optional account-level token, used by `npm run check:postmark` to verify the
# sender below.
POSTMARK_ACCOUNT_TOKEN=""
# From address on transactional mail. Must be a confirmed Postmark Sender
# Signature or on a verified domain.
MAIL_FROM_ADDRESS="no-reply@example.com"
# Sender name shown in the inbox.
MAIL_FROM_NAME="Rapi Management"

# --- Google Analytics 4 / BigQuery (Traffic Source Report) ---
# GCP service account JSON key (BigQuery Data Viewer + BigQuery Job User on
# the target project). Place the file under ./secrets/ (gitignored) — never
# under public/, which is served as static files.
GOOGLE_APPLICATION_CREDENTIALS="./secrets/your-service-account-key.json"
GCP_PROJECT_ID=""
GA4_PROPERTY_ID=""
BIGQUERY_DATASET=""

# React Router 8 requires React >=19.2.7, but @shopify/polaris@13 still
# peer-declares react@^18. Polaris 13 is runtime-compatible with React 19
# (it uses no React-18-removed APIs), so we relax peer resolution here to let
# the two coexist. Remove this once Polaris ships a React-19 peer range.
legacy-peer-deps=true

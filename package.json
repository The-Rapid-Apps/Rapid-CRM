{
  "name": "rapid",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "node --import tsx ./server.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backfill-partner-connections": "tsx scripts/backfill-partner-connections.ts",
    "shopify:discover-apps": "tsx scripts/discover-partner-apps.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test --test-force-exit --import ./tests/fixtures/test-env.ts --import ./tests/redis-teardown.ts --test-concurrency=1 tests/*.test.ts",
    "sync:shopify": "tsx scripts/sync-shopify.ts",
    "seed:demo-plans": "tsx scripts/seed-demo-plans.ts",
    "snapshot:install": "tsx scripts/backfill-install-snapshot.ts",
    "backfill:uninstall-reasons": "tsx scripts/backfill-uninstall-reasons.ts",
    "check:app-names": "tsx scripts/check-shopify-app-names.ts",
    "check:postmark": "tsx scripts/check-postmark.ts",
    "postmark:push-templates": "tsx scripts/push-postmark-templates.ts",
    "sync:live-discounts": "tsx scripts/sync-live-discount-checks.ts",
    "backfill:mrr-movement": "tsx scripts/backfill-mrr-movement.ts",
    "backfill:plan-mrr": "tsx scripts/backfill-plan-mrr-snapshot.ts",
    "diagnose:traffic": "tsx scripts/diagnose-traffic-sources.ts",
    "diagnose:traffic-report": "tsx scripts/diagnose-traffic-report.ts",
    "repair:traffic-mirror": "tsx scripts/repair-traffic-mirror.ts",
    "check:traffic-parity": "tsx scripts/check-traffic-parity.ts",
    "cleanup:api-logs": "tsx scripts/cleanup-api-logs.ts",
    "backfill:usage": "tsx scripts/backfill-usage.ts",
    "sync:org-logo-churn": "tsx scripts/sync-org-logo-churn.ts",
    "backfill:drain": "tsx scripts/drain-backfill.ts",
    "backfill:app-api-keys": "tsx scripts/backfill-app-api-keys.ts",
    "user:create": "tsx scripts/user-create.ts",
    "user:reset": "tsx scripts/user-reset.ts",
    "verify:flex": "tsx scripts/verify-flex.ts",
    "verify:customer-events": "tsx scripts/verify-customer-events.ts",
    "verify:team": "tsx scripts/verify-team-invites.ts",
    "report:mrr-bands": "tsx scripts/print-mrr-bands.ts",
    "check:connections": "tsx scripts/check-shopify-connections.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/polaris-viz": "^16.16.0",
    "@shopify/shopify-api": "^13.1.0",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.36",
    "mariadb": "^3.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.4.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "$mariadb"
    },
    "prisma": {
      "mysql2": "^3.24.4",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
